# AI Binance Trading Company - Environment Configuration Example
# Sao chép file này thành .env và điền các khóa API của bạn

# Môi trường ứng dụng
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Chế độ giao dịch mặc định (PAPER, TESTNET, LIVE)
TRADING_MODE=PAPER

# Cấu hình AI Gateway (Một API Key và Base URL cho cả 2 mô hình)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-placeholder-api-key-here
GPT_MODEL_ID=gpt-6-luna
GEMINI_MODEL_ID=gemini-3.8-flash
GPT_REASONING_LEVEL=high
GEMINI_REASONING_LEVEL=high
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_MAX_TOKENS=2048
MAX_AI_COST_PER_DAY=5.0

# Khóa API Binance Spot (LIVE)
BINANCE_API_KEY=your_binance_live_api_key_here
BINANCE_API_SECRET=your_binance_live_api_secret_here

# Khóa API Binance Spot Testnet (testnet.binance.vision)
BINANCE_TESTNET_API_KEY=your_binance_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_binance_testnet_secret_here

# Quản trị rủi ro & Vốn (Conservative Defaults)
BOT_ALLOCATED_CAPITAL_USDT=100.0
MAX_RISK_PER_TRADE_PERCENT=1.0
MAX_POSITION_SIZE_PERCENT=25.0
DAILY_MAX_LOSS_PERCENT=2.0
MAX_DRAWDOWN_PERCENT=5.0
MAX_CONCURRENT_POSITIONS=2
MAX_DAILY_ENTRIES=5
COOLDOWN_MINUTES=20
EVALUATION_INTERVAL_SECONDS=300

# Khóa an toàn chế độ LIVE SPOT (Mặc định luôn khóa khi khởi động lại)
LIVE_SPOT_LOCKED=true
EMERGENCY_STOP_ACTIVE=false

# Thông báo
DESKTOP_NOTIFICATIONS_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
